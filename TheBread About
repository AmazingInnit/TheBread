<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>About Us - TheBread.com</title>
    
    <style>
        /*BACKGROUND*/
        body 
        {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: #221a13;
            font-family: sans-serif; 
            text-align: center;
        }
        nav
        {
            text-align: right;
            padding: 10px 16px 0;
        }
        .nav
        {
            background-color: #604917;
            color: white;
            border: none;
            padding: 8px 20px;
            font-family: sans-serif;
            font-size: 15px;
            border-radius: 4px; 
            margin-top: 10px; 
            margin-bottom: 10px; 
            margin-right: 5px;
            cursor: pointer;
        }
        h1 
        {
            font-family: 'Times New Roman', Times, serif;
            font-size: 34px;
            color: #fff6e5;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.45);
            margin-top: 16px;
            margin-bottom: 12px;
        }
        h2
        {
            margin-top: 10px;
            margin-bottom: 12px;
            font-family: 'Times New Roman', Times, serif;
            font-size: 26px;
            color: #f5ebd6;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
        }
        h3
        {
            font-family: 'Times New Roman', Times, serif;
            font-size: 22px;
            color: #f5ebd6;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
            margin-top: 0;
        }
        button:hover 
        {
            background-color: #52270b; 
        }
        p 
        {
            color: #e8dcc4;
            font-family: sans-serif;
            font-size: 16px;
            line-height: 1.5;
            margin-top: 8px;
            margin-bottom: 10px;
        }
        .button
        {
            background-color: #718328;
            color: white;
            border: none;
            padding: 10px 22px;
            font-family: sans-serif;
            font-size: 15px;
            border-radius: 6px;
            width: 160px;
            margin-top: 14px;
            cursor: pointer;
        }
        .button:hover
        {
            background-color: #565124;
        }
        .background_img
        {
            position: fixed;
            inset: 0;             
            width: 100%;
            height: 100%;
            object-fit: cover;    
            object-position: center;
            z-index: -1;           
            pointer-events: none;
        }
        .stage 
        {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 12px 16px;
            position: relative;
            z-index: 1;
        }

        /* The rectangle in the middle */
        .rectangle 
        {
            width: 460px;
            max-width: 100%;   
            min-height: 180px;
            padding: 24px 22px;
            box-sizing: border-box;
            background: rgba(34, 26, 19, 0.78);
            backdrop-filter: blur(1px);
            border: 1px solid rgba(255, 210, 145, 0.25);
            border-radius: 5px;  
        }
        footer p
        {
            color: #fff6e5;
            font-family: sans-serif;
            font-size: 14px;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
        }
    </style>
</head>
<body>
   
    <header>
        <nav>
            <a href="TheBread Page.html"><button class="nav">TheBread Page</button></a>
            <a href="TheBread.html"><button class="nav">Home</button></a>
        </nav>
    </header>

    <div class="stage">
        <h1>About Us</h1>
        <div class="rectangle">
            <p>Our website is about making scripure reading more awesome!</p>
            <a href="TheBread Page.html"><button class="button">Back to Devotion</button></a>
        </div>
    </div>

    <img src="TheBread BG.png" alt="Background image" class="background_img"/>

    <footer>
        <p>&copy; 2026 TheBread. All rights reserved.</p>
    </footer>
</body>
</html>
